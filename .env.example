# GEMINI_API_KEY: Required for Gemini AI API calls (opportunity reasoning, outreach generation).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Default Data Provider ('open_data', 'osm', 'search')
DATA_PROVIDER_DEFAULT="open_data"

# Optional Supabase Integration (for external remote PostgreSQL synchronization)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Paystack Integration (for future commercial billing)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
